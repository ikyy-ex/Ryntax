# Isi di Netlify: Site configuration > Environment variables. JANGAN commit file .env ke GitHub.
GEMINI_API_KEY=        # dari Google AI Studio (aistudio.google.com), ada kuota gratis
GEMINI_MODEL=          # opsional, default gemini-2.5-flash; cek daftar model terbaru di dokumentasi Google
REMOVEBG_API_KEY=      # dari remove.bg/api (kredit gratis terbatas, selebihnya berbayar)
ALLOWED_ORIGIN=        # opsional, mis. https://domain-anda.netlify.app (default: *)
